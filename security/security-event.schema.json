{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brasa.world/security-event.v1.json",
  "title": "BRASA Shield security event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "event", "requestId", "severity", "route", "method", "status", "durationMs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "event": { "enum": ["public_api_request", "gateway_unhandled_error"] },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
    "route": { "type": "string", "maxLength": 100 },
    "method": { "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"] },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "durationMs": { "type": "integer", "minimum": 0 }
  }
}
