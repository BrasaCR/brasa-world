{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brasa-content-api",
  "main": "src/content-api.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": ".api-assets", "binding": "ASSETS", "run_worker_first": ["/v1/*", "/powered-by-brasa", "/health"] },
  "services": [
    { "binding": "EDUCATION", "service": "brasa-education" },
    { "binding": "BUSINESS", "service": "brasa-business" },
    { "binding": "GOVERNMENT", "service": "brasa-government" }
  ],
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "brasa_content_api" }],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "staging": {
      "name": "brasa-content-api-staging",
      "workers_dev": true,
      "d1_databases": [
        { "binding": "API_DB", "database_name": "brasa-api-staging", "database_id": "d4e42dc0-2eec-4e9e-a216-1418f02ef355", "migrations_dir": "migrations-api" }
      ],
      "services": [
        { "binding": "EDUCATION", "service": "brasa-education-staging" },
        { "binding": "BUSINESS", "service": "brasa-business-staging" },
        { "binding": "GOVERNMENT", "service": "brasa-government-staging" }
      ],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "brasa_content_api_staging" }]
    }
  }
}
