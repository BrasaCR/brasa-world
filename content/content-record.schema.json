{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.brasa.world/content-record.v1.json",
  "title": "BRASA content record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "url", "title", "locale", "kind", "pillar", "offline"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "url": { "type": "string", "pattern": "^/" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
    "countryCode": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
    "kind": { "enum": ["homepage", "country", "human-capability", "public-service", "open-ledger", "explainer", "other"] },
    "pillar": { "enum": ["world", "human-capability", "civic-knowledge", "marketplace", "brasa-open", "brasa-shield"] },
    "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "offline": { "type": "boolean" }
  }
}
